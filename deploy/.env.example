# Локальные дефолты. deploy/.env не коммитится (см. deploy/.gitignore).

# --- Postgres ---
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_PORT=5432

# --- S3 / RustFS ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=todo-s3
S3_SECRET_KEY=todo-s3-secret
S3_REGION=us-east-1
S3_BUCKET_AUDIO=audio
S3_BUCKET_TTS=tts
AUDIO_RETENTION_DAYS=7

# CORS для presigned PUT/GET. "*" покрывает http://localhost:<любой порт>
# и http://127.0.0.1:<любой порт>; явный allowlist тоже поддерживается:
# S3_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
S3_CORS_ALLOWED_ORIGINS=*

# --- Для конфигов приложений (compose эти значения не читает) ---
# Presigned URL подписывается на S3_PUBLIC_HOST:S3_PUBLIC_PORT.
# S3_PUBLIC_PORT должен совпадать с S3_PORT (порт, опубликованный compose).
# Для локального демо — localhost:9000; для LAN — IP/домен хоста и тот же порт.
# S3_ENDPOINT должен совпадать с http://<S3_PUBLIC_HOST>:<S3_PUBLIC_PORT>.
S3_PUBLIC_HOST=localhost
S3_PUBLIC_PORT=9000
S3_ENDPOINT=http://localhost:9000

# Внутренний адрес для будущих контейнеров в todo-net.
# В presigned URL его отдавать нельзя: имя s3 не резолвится на хосте.
S3_INTERNAL_ENDPOINT=http://s3:9000

DATABASE_URL=postgres://todo:todo@127.0.0.1:5432/todo
S3_PRESIGN_TTL_UPLOAD=600
S3_PRESIGN_TTL_DOWNLOAD=900
