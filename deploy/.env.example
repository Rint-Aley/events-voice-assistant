# Локальные переменные. deploy/.env не коммитится (см. deploy/.gitignore).

# --- Postgres ---
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_PORT=5432

# --- S3 / RustFS ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=todo-s3
S3_SECRET_KEY=todo-s3-secret
S3_REGION=us-east-1
S3_BUCKET_AUDIO=audio
S3_BUCKET_TTS=tts
AUDIO_RETENTION_DAYS=7

# CORS для presigned PUT/GET. "*" подходит для http://localhost:<порт> и
# http://127.0.0.1:<порт>; точный allowlist требует перечисления:
# S3_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
S3_CORS_ALLOWED_ORIGINS=*

# --- Голосовые сервисы (compose поднимает их в контейнерах) ---
STT_PORT=8010
STT_MODEL=base
STT_DEADLINE_SECONDS=25
STT_LANGUAGE=ru

TTS_PORT=8020
TTS_DEFAULT_VOICE=ru-RU-SvetlanaNeural
TTS_DEFAULT_FORMAT=mp3
TTS_TIMEOUT_SECONDS=20

# --- NLU ---
NLU_PORT=8001
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# true — без вызова LLM, только rules-based fallback (офлайн-демо и тесты)
RULES_ONLY=false
TIMEZONE=Europe/Moscow

# --- TaskManager ---
# Внутри контейнера TaskManager слушает 8080; с хоста — этот порт.
TASKMANAGER_PORT=5000

# --- Web ---
WEB_PORT=8080
# web проксирует /api/ на TaskManager внутри todo-net.
TASKMANAGER_URL=http://taskmanager:8080

# --- S3 / presigned ---
# Адрес в подписи presigned URL. Для TaskManager (в контейнере и на хосте)
# это публичный localhost:9000, а не внутренний s3:9000: TaskManager не ходит
# в S3 по сети, а только подписывает ссылки.
# S3_PUBLIC_PORT должен совпадать с S3_PORT (иначе проброшенный порт не совпадает с подписью).
# Для локальной машины — localhost:9000; для LAN — IP/хост машины в сети.
S3_PUBLIC_HOST=localhost
S3_PUBLIC_PORT=9000
S3_ENDPOINT=http://localhost:9000

# Внутренний адрес S3 для контейнеров в todo-net.
# В presigned URL он не попадает: подпись совпадает только с S3_PUBLIC_HOST.
S3_INTERNAL_ENDPOINT=http://s3:9000

# Для запуска TaskManager и EF-команд на хосте. В контейнере compose задаёт
# TASKMANAGER_CONNECTION_STRING с внутренним адресом postgres:5432.
DATABASE_URL=postgres://todo:todo@127.0.0.1:5432/todo
S3_PRESIGN_TTL_UPLOAD=600
S3_PRESIGN_TTL_DOWNLOAD=900
