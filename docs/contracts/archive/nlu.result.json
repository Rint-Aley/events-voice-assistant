{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo-agent.local/contracts/nlu.result.json",
  "title": "nlu.results.v1",
  "description": "План действий, извлечённый из текста. Только описание намерения: NLU не выполняет действий и не возвращает SQL.",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "properties": {
        "job_type": { "const": "nlu" },
        "payload": { "$ref": "#/$defs/payload" }
      },
      "required": ["job_type", "payload"]
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "confidence", "entities", "missing_slots"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create_task",
            "create_meeting",
            "list_items",
            "search_items",
            "clarify",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "datetime_iso",
            "datetime_phrase",
            "period",
            "range",
            "query",
            "target_ref",
            "duration_minutes"
          ],
          "properties": {
            "title": {
              "type": ["string", "null"],
              "maxLength": 500
            },
            "datetime_iso": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "Абсолютное время с офсетом, посчитанное относительно reference_datetime."
            },
            "datetime_phrase": {
              "type": ["string", "null"],
              "maxLength": 200,
              "description": "Исходная фраза ('завтра в десять'). Бэкенд перепроверяет по ней дату при сомнении."
            },
            "period": {
              "type": ["string", "null"],
              "enum": [
                "today",
                "tomorrow",
                "day_after_tomorrow",
                "week",
                "next_week",
                "range",
                "all",
                null
              ]
            },
            "range": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "to"],
                  "properties": {
                    "from": { "type": "string", "format": "date-time" },
                    "to": { "type": "string", "format": "date-time" }
                  }
                },
                { "type": "null" }
              ]
            },
            "query": {
              "type": ["string", "null"],
              "maxLength": 500
            },
            "target_ref": {
              "type": ["string", "null"],
              "enum": ["last", "by_title", "by_id", null]
            },
            "duration_minutes": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 1440
            }
          }
        },
        "missing_slots": {
          "type": "array",
          "items": { "type": "string", "enum": ["title", "datetime", "time", "query"] },
          "uniqueItems": true
        }
      }
    }
  }
}
