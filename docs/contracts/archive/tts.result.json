{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo-agent.local/contracts/tts.result.json",
  "title": "tts.results.v1",
  "description": "Результат синтеза. Ключ объекта детерминирован (хэш текста), поэтому повторная запись идемпотентна.",
  "allOf": [
    { "$ref": "./envelope.json" },
    {
      "properties": {
        "job_type": { "const": "tts" },
        "payload": { "$ref": "#/$defs/payload" }
      },
      "required": ["job_type", "payload"]
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_key", "duration_ms", "cached"],
      "properties": {
        "object_key": {
          "type": "string",
          "pattern": "^tts/[a-f0-9]{64}\\.(mp3|ogg)$"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "boolean",
          "description": "true — объект уже существовал, синтез не выполнялся."
        }
      }
    }
  }
}
