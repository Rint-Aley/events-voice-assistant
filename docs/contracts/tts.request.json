{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://todo-agent.local/contracts/tts.request.json",
  "title": "TTS request",
  "description": "TaskManager -> tts. POST /v1/synthesize. Озвучивается готовый текст ответа.",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer_id", "text", "voice", "format"],
  "properties": {
    "answer_id": {
      "type": "string",
      "format": "uuid",
      "description": "Ключ идемпотентности: ключ объекта детерминирован парой (text, voice), повтор не создаёт дубль."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "voice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Идентификатор голоса у провайдера."
    },
    "format": {
      "type": "string",
      "enum": ["ogg_opus", "mp3", "wav"]
    },
    "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2,
      "default": 1
    }
  }
}
