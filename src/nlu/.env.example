# LLM (OpenAI-совместимый API)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20

# Эмбеддинги (тот же API или отдельный).
# Зафиксировано для TaskManager: text-embedding-3-small, размерность 1536.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Если true — LLM не вызывается, работает только rules-based fallback
RULES_ONLY=false

TIMEZONE=Europe/Moscow
